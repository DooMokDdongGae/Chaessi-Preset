{
  "name": "chaessi-preset",
  "productName": "Chaessi Preset",
  "version": "3.8.1",
  "description": "Generate with NovelAI. Organize and finish with CHAESSI PRESET.",
  "author": "Chaessi Preset",
  "license": "MIT",
  "main": "electron/main.mjs",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.mjs",
    "mcp:start": "node mcp/server.mjs",
    "test:mcp": "node --test tests/mcp.test.mjs",
    "electron:dev": "electron .",
    "electron:pack": "electron-builder --dir",
    "electron:dist": "electron-builder --win portable",
    "test:wildcard": "node --test tests/wildcard.test.mjs tests/wildcard-endpoint.test.mjs",
    "test:regression": "node scripts/run-regressions.mjs",
    "test:character-preset-ui": "node scripts/verify-character-preset-categories.mjs",
    "test:character-preset-preferences": "node --test tests/character-preset-preferences.test.mjs",
    "test:character-preset-restart": "node scripts/verify-character-preset-restart.mjs",
    "test:workbench": "node scripts/verify-workbench.mjs",
    "test:multilingual": "node --test tests/multilingual-workbench.test.mjs",
    "test:multilingual-ui": "node scripts/verify-multilingual-workbench.mjs",
    "test:v360": "node --test tests/v360.test.mjs tests/wildcard.test.mjs tests/wildcard-endpoint.test.mjs tests/multilingual-workbench.test.mjs tests/character-preset-preferences.test.mjs tests/mcp.test.mjs",
    "test:v360-workflow": "node scripts/verify-v360-workflow.mjs",
    "test:image-tools": "node --test tests/image-tools.test.mjs",
    "test:image-tools-ui": "node scripts/verify-image-tools-ui.mjs",
    "test:composition": "node --test tests/composition.test.mjs",
    "test:composition-ui": "node scripts/verify-composition-ui.mjs",
    "test:pixel-resolution": "node --test tests/pixel-snap.test.mjs tests/resolutions.test.mjs",
    "test:pixel-resolution-ui": "node scripts/verify-pixel-resolution-ui.mjs",
    "prestart": "node scripts/sync-version.mjs",
    "preelectron:pack": "node scripts/sync-version.mjs",
    "preelectron:dist": "node scripts/sync-version.mjs"
  },
  "devDependencies": {
    "electron": "^42.11.16",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.chaessi.preset",
    "productName": "Chaessi Preset",
    "icon": "assets/branding/chaessi-preset.ico",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "server.mjs",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "electron/**/*",
      "src/**/*",
      "mcp/**/*",
      "assets/**/*",
      "manuals/*.pdf",
      "!**/.env",
      "!**/.env.*",
      "!secrets/**",
      "!data/secrets/**",
      "!logs/**",
      "!tmp/**",
      "!data/tmp/**",
      "!data/**",
      "!docs/**",
      "!test_*.js",
      "!*.py",
      "!*.txt",
      "!rebuild_blueprint.md"
    ],
    "win": {
      "icon": "assets/branding/chaessi-preset.ico",
      "target": [
        "dir",
        "portable"
      ],
      "artifactName": "Chaessi-Preset-v${version}-${arch}.${ext}"
    },
    "portable": {
      "unpackDirName": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@msgpack/msgpack": "^3.1.3",
    "sharp": "0.35.5",
    "zod": "3.25.76"
  }
}
